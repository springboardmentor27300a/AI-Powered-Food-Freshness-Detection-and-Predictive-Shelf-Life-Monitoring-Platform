# Backend .dockerignore
# Exclude files that don't need to be in the Docker build context

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
.env

# Test files
test_*.py
verify_*.py
*.test.py

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Docker
Dockerfile*
.dockerignore
