# FreshGuard Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================================
# Database Configuration
# ============================================================
POSTGRES_DB=freshguard
POSTGRES_USER=freshguard
POSTGRES_PASSWORD=change-this-password-in-production

# ============================================================
# Backend Configuration
# ============================================================
# JWT Secret - MUST be a strong random value in production
JWT_SECRET=change-this-secret-in-production

# CORS Origins - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Frontend Configuration
# ============================================================
# API URL for the frontend to connect to the backend
# This is the browser-facing URL, not the Docker internal URL
VITE_API_URL=http://localhost:8000
