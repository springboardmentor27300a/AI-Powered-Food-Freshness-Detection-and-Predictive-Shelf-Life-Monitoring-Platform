# ===========================================================================
# Food Freshness Monitoring Platform - Environment Configuration Template
# Infosys Springboard Internship - Milestone 4
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# Used by: docker compose (containers) and local (non-Docker) development.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database configuration (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=food_freshness_db
POSTGRES_PORT=5432

# SQLAlchemy connection string.
#  - Local development : host = localhost
#  - Docker Compose    : host = `database` (the compose service name).
#    docker-compose.yml builds this automatically from the POSTGRES_* values
#    above, so you normally do not need to edit it for Docker runs.
DATABASE_URL=postgresql+psycopg2://postgres:change_me_strong_password@localhost:5432/food_freshness_db

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# JWT signing secret (read by FastAPI as SECRET_KEY).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
# Placeholder alias for the same JWT secret (documentation/tooling only;
# the backend signs tokens with SECRET_KEY).
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# CORS (only needed when the frontend is served from a different origin,
# e.g. local `npm run dev` on :5173. In Docker the Nginx /api proxy means
# every request is same-origin, so CORS is not used.)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Frontend API URL
#  - Local `npm run dev` : http://localhost:8000 (direct to FastAPI)
#  - Docker image build  : /api (Nginx proxies to the `backend` service)
#    Set by docker-compose.yml as a build arg; nothing to change here.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
