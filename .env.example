# ═══════════════════════════════════════════════════════════════
# FreshSense AI — Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ── MongoDB Atlas (Cloud Database) ──
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=freshsense_db

# ── JWT Authentication ──
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application Settings ──
PROJECT_NAME=FreshSense AI
API_V1_STR=/api
ENVIRONMENT=production

# ── Admin Registration Key ──
ADMIN_REGISTRATION_KEY=freshsense-admin-2024

# ── Azure Container Registry (for Azure deployment) ──
AZURE_REGISTRY=freshsenseacr.azurecr.io
AZURE_RESOURCE_GROUP=freshsense-rg
AZURE_LOCATION=eastus

# ── CORS Origins (comma-separated) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-production-domain.com
