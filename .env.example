# ============================================================================
# Food Freshness Monitoring Platform - environment variables
# Copy to backend/.env (backend) and frontend/.env (frontend) and set real
# values for your environment. NEVER commit real secrets.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# MongoDB connection string (required).
# Local:  mongodb://localhost:27017
# Docker: mongodb://mongo:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/food_freshness
MONGO_URL=mongodb://localhost:27017

# JWT signing secret (REQUIRED IN PRODUCTION - the app refuses to start in
# production without it). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT algorithm and token lifetime (minutes; default 1440 = 24 h)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Deployment environment. Set to "production" to enforce production checks
# (e.g. SECRET_KEY becomes mandatory).
ENVIRONMENT=development

# Allowed CORS origins, comma-separated (frontend URLs)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Development-only MongoDB TLS opt-out (1 = allow invalid certificates).
# NEVER set this in production; certificates are validated by default.
MONGO_TLS_ALLOW_INVALID=0

# ---------------------------------------------------------------------------
# Frontend (Vite: must be prefixed with VITE_ and set at BUILD time)
# ---------------------------------------------------------------------------

# Base URL of the backend API, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000
