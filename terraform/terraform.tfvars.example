# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to Git (it contains secrets)

aws_region     = "us-east-1"
key_pair_name  = "your-key-pair-name"       # Name of your EC2 key pair in AWS Console
app_secret_key = "replace-with-a-long-random-string"
github_repo    = "your-github-username/food-freshness-monitoring-platform"
instance_type  = "t3.medium"
