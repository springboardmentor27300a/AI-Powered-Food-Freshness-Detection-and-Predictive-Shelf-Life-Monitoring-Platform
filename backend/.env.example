# ---- Database ----
DATABASE_URL=postgresql://freshness_user:freshness_pass@localhost:5432/freshness_db

# ---- JWT ----
SECRET_KEY=change-this-to-a-random-64-character-string-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Milestone 2/3 ----
# Folder (relative to backend/) where uploaded food images are stored.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8
