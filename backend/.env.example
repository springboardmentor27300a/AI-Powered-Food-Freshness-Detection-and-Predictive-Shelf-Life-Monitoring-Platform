# ---------------------------------------------------------------------------
# Food Freshness Monitoring Platform - backend environment template.
# Copy this file to `.env` and fill in REAL values. Never commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (SQLAlchemy format).
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/food_freshness_db

# Secret key used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_long_random_secret

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
